"SimulationRun.SimModules.SimSensors" [color="black", fontcolor="black", label=<{SimSensors|sensors<br ALIGN="LEFT"/>|step(ctx: SimInfo)<br ALIGN="LEFT"/>}>, shape="record", style="solid"];
