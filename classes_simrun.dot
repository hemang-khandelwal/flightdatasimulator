digraph "classes_simrun" {
rankdir=BT
charset="utf-8"
"SimulationRun.SimModules.SimControls" [color="black", fontcolor="black", label=<{SimControls|controls<br ALIGN="LEFT"/>|step(ctx: SimInfo)<br ALIGN="LEFT"/>}>, shape="record", style="solid"];
